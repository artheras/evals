<mujoco model="arm">
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  <worldbody>
    <body name="upper">
      <joint name="shoulder" type="hinge" axis="0 0 1" damping="0.4"/>
      <geom type="capsule" fromto="0 0 0 0.5 0 0" size="0.03" mass="1.2"/>
      <body name="fore" pos="0.5 0 0">
        <joint name="elbow" type="hinge" axis="0 0 1" damping="0.4"/>
        <geom type="capsule" fromto="0 0 0 0.4 0 0" size="0.025" mass="0.8"/>
        <site name="tip" pos="0.4 0 0"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor joint="shoulder" gear="1" ctrlrange="-8 8"/>
    <motor joint="elbow" gear="1" ctrlrange="-8 8"/>
  </actuator>
</mujoco>
